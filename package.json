{
  "name": "1337x-steam-hover-preview",
  "version": "5.0.8",
  "private": true,
  "type": "module",
  "description": "Standalone 1337x Steam hover userscript using a pinned shared core",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "sync-core": "node scripts/sync-core.mjs",
    "lint": "eslint src scripts tests",
    "format": "prettier --write src scripts tests *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.mjs *.json .github/workflows/*.yml",
    "test:browser": "node scripts/browser-check.mjs --site=1337x"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "playwright": "1.64.1"
  }
}
